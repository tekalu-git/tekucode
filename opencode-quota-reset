#!/usr/bin/env bash
# opencode-quota-reset - Wrapper to run quota reset from anywhere
# Usage: opencode-quota-reset [--force]

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Try to find bun
if command -v bun >/dev/null 2>&1; then
  BUN_CMD="bun"
elif [[ -f "$HOME/.bun/bin/bun" ]]; then
  BUN_CMD="$HOME/.bun/bin/bun"
else
  echo "Error: Could not find bun. Please install it or add to PATH."
  exit 1
fi

# Run the quota reset command using the dev source
exec "$BUN_CMD" run --cwd "$SCRIPT_DIR/packages/cli" src/index.ts debug reset-quota "$@"
#!/usr/bin/env bash
# opencode-wiper — wipe opencode data and rotate IP via ProtonVPN WireGuard configs

set -euo pipefail

export PATH="/home/tekalu/.bun/bin:$PATH"
OPENCODE_SOURCE="/home/tekalu/Documents/Projects/TekuCode/opencode/opencode-source"
WG_DIR="/home/tekalu/.config/protonvpn-wg"
CONFIGS=("$WG_DIR/nl-free-239.conf" "$WG_DIR/ca-free-36.conf" "$WG_DIR/us-free-86.conf")

echo "=== Exit OpenCode first ==="
pkill -f "opencode.*serve" 2>/dev/null || true
pkill -f "opencode-source" 2>/dev/null || true
sleep 1

echo "=== Current OpenCode paths ==="
"$OPENCODE_SOURCE" debug paths 2>&1 || true

echo "=== Removing OpenCode user data ==="
rm -rf /home/tekalu/.config/opencode
rm -rf /home/tekalu/.local/share/opencode
rm -rf /home/tekalu/.cache/opencode
rm -rf /home/tekalu/.local/state/opencode
if [ -d /home/tekalu/.opencode ]; then
    find /home/tekalu/.opencode -mindepth 1 -maxdepth 1 \
        ! -name bin -exec rm -rf -- {} +
fi

echo
echo "=== IP Rotation via ProtonVPN WireGuard (NL/CA/US free) ==="
echo "Clearnet IP: $(curl -s -m 8 https://api.ipify.org 2>/dev/null || echo 'unknown')"

# Disconnect any existing WireGuard
for cfg in "${CONFIGS[@]}"; do
    IFACE=$(basename "$cfg" .conf)
    sudo wg-quick down "$cfg" 2>/dev/null || true
done

# Pick random config
RANDOM_CFG="${CONFIGS[$RANDOM % ${#CONFIGS[@]}]}"
IFACE=$(basename "$RANDOM_CFG" .conf)
echo "Connecting via $IFACE..."

sudo wg-quick up "$RANDOM_CFG" 2>&1 | tail -3
sleep 5

echo "New IP: $(curl -s -m 15 https://api.ipify.org 2>/dev/null || echo 'unknown')"

# Keep connection up (user can disconnect later with: sudo wg-quick down <config>)
echo
echo "=== WireGuard UP ($IFACE) — run to disconnect: sudo wg-quick down $RANDOM_CFG ==="

echo
echo "=== Checking installation ==="
hash -r
"$OPENCODE_SOURCE" --version

echo
echo "=== Checking regenerated paths ==="
"$OPENCODE_SOURCE" debug paths